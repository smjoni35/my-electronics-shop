<%- include('partials/header') %>

<% const isNew = (Date.now() - new Date(product.created_at).getTime()) < NEW_PRODUCT_DAYS * 24 * 60 * 60 * 1000; %>
<% const isLowStock = product.stock > 0 && product.stock <= LOW_STOCK_THRESHOLD; %>

<nav class="breadcrumb" aria-label="breadcrumb">
    <a href="/">হোম</a> <span class="breadcrumb-sep">/</span>
    <% if (product.category) { %>
        <a href="/?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a> <span class="breadcrumb-sep">/</span>
    <% } %>
    <span class="breadcrumb-current"><%= product.name %></span>
</nav>

<div class="product-detail">
    <div class="product-detail-img">
        <div class="badge-stack">
            <% if (isNew) { %><span class="badge-new">✨ New</span><% } %>
            <% if (product.discount_percent > 0) { %><span class="badge-discount">সেভ <%= product.discount_percent %>%</span><% } %>
        </div>
        <% const allPhotos = [product.image_url, ...galleryImages.map(g => g.image_url)].filter(Boolean); %>
        <% if (allPhotos.length > 0) { %>
            <div class="main-slider" id="main-slider">
                <div class="main-slider-track" id="main-slider-track">
                    <% allPhotos.forEach((url, i) => { %>
                        <img src="<%= url %>" class="main-slide" alt="<%= product.name %>" loading="<%= i === 0 ? 'eager' : 'lazy' %>">
                    <% }) %>
                </div>
            </div>
            <% if (allPhotos.length > 1) { %>
            <div class="gallery-thumbs" id="gallery-thumbs">
                <% allPhotos.forEach((url, i) => { %>
                    <img src="<%= url %>" class="gallery-thumb <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>">
                <% }) %>
            </div>
            <script>
            (function () {
                var slider = document.getElementById('main-slider');
                var track = document.getElementById('main-slider-track');
                var thumbsWrap = document.getElementById('gallery-thumbs');
                var thumbs = Array.prototype.slice.call(document.querySelectorAll('.gallery-thumb'));
                var total = <%= allPhotos.length %>;
                var index = 0;
                var startX = 0, currentX = 0, dragging = false, sliderWidth = slider.offsetWidth;

                function goTo(i, animate) {
                    index = Math.max(0, Math.min(total - 1, i));
                    track.style.transition = animate === false ? 'none' : 'transform 0.35s ease';
                    track.style.transform = 'translateX(-' + (index * 100) + '%)';
                    thumbs.forEach(function (t) { t.classList.remove('active'); });
                    thumbs[index].classList.add('active');
                    var activeThumb = thumbs[index];
                    thumbsWrap.scrollTo({
                        left: activeThumb.offsetLeft - (thumbsWrap.clientWidth / 2) + (activeThumb.clientWidth / 2),
                        behavior: 'smooth'
                    });
                }

                thumbs.forEach(function (t) {
                    t.addEventListener('click', function () { goTo(parseInt(t.dataset.index, 10)); });
                });

                window.addEventListener('resize', function () { sliderWidth = slider.offsetWidth; goTo(index, false); });

                slider.addEventListener('touchstart', function (e) {
                    startX = e.touches[0].clientX;
                    currentX = startX;
                    dragging = true;
                    sliderWidth = slider.offsetWidth;
                    track.style.transition = 'none';
                }, { passive: true });

                slider.addEventListener('touchmove', function (e) {
                    if (!dragging) return;
                    currentX = e.touches[0].clientX;
                    var diff = currentX - startX;
                    var percent = (diff / sliderWidth) * 100;
                    track.style.transform = 'translateX(calc(-' + (index * 100) + '% + ' + diff + 'px))';
                }, { passive: true });

                slider.addEventListener('touchend', function () {
                    if (!dragging) return;
                    dragging = false;
                    var diff = currentX - startX;
                    if (Math.abs(diff) > sliderWidth * 0.15) {
                        if (diff < 0) goTo(index + 1);
                        else goTo(index - 1);
                    } else {
                        goTo(index);
                    }
                    startX = 0; currentX = 0;
                });
            })();
            </script>
            <% } %>
        <% } else { %>
            <div class="no-img large">ছবি নেই</div>
        <% } %>
    </div>
    <div class="product-detail-info">
        <h1><%= product.name %></h1>

        <p class="price-row" id="priceDisplay">
            <% if (product.discount_percent > 0) { %>
                <span class="price large" id="priceCurrent">৳<%= basePrice.toLocaleString('en-BD') %></span>
                <span class="price-original large" id="priceOriginal">৳<%= parseFloat(product.price).toLocaleString('en-BD') %></span>
            <% } else { %>
                <span class="price large" id="priceCurrent">৳<%= basePrice.toLocaleString('en-BD') %></span>
            <% } %>
        </p>
        <% if (product.category) { %><p class="category-tag"><%= product.category %></p><% } %>
        <% if (product.warranty) { %><span class="badge-warranty">🛡️ <%= product.warranty %></span><% } %>

        <a href="#reviews" class="star-rating large" title="<%= avgRating.toFixed(1) %> / 5">
            <% for (let i = 1; i <= 5; i++) { %><span class="star <%= i <= Math.round(avgRating) ? 'filled' : '' %>">★</span><% } %>
            <span class="review-count"><%= avgRating.toFixed(1) %> (<%= reviewCount || 0 %> রিভিউ)</span>
        </a>

        <% if (inStock) { %>
            <% if (variantOptions.length > 0) { %>
                <div class="variant-select-row">
                    <label>ভ্যারিয়েন্ট বাছাই করুন *
                        <select id="variantSelect" required>
                            <option value="">বাছাই করুন</option>
                            <% variantOptions.forEach(v => { %>
                                <option value="<%= v.id %>" data-price="<%= v.price %>" data-stock="<%= v.stock %>" <%= v.stock <= 0 ? 'disabled' : '' %>>
                                    <%= v.label %><%= v.stock <= 0 ? ' — স্টক নেই' : '' %>
                                </option>
                            <% }) %>
                        </select>
                    </label>
                </div>
                <p class="stock-info stock-dot" id="stockInfo">ভ্যারিয়েন্ট বাছাই করলে স্টক দেখাবে</p>
            <% } else { %>
                <p class="stock-info stock-dot" id="stockInfo">স্টকে আছে: <%= product.stock %> টি</p>
                <% if (isLowStock) { %><span class="badge-lowstock">মাত্র <%= product.stock %>টা বাকি — তাড়াতাড়ি করুন!</span><% } %>
            <% } %>
            <p class="delivery-estimate">
                <span class="delivery-estimate-icon">🚚</span>
                <span class="delivery-estimate-text"><strong>২-৩ দিনের মধ্যে ডেলিভারি</strong> (ঢাকার ভিতরে)</span>
            </p>
            <p class="return-policy-note">🔁 ৭ দিনের মধ্যে রিটার্ন/এক্সচেঞ্জ সুবিধা — <a href="/return-policy">বিস্তারিত জানুন</a></p>
            <div class="product-cta-row">
                <form action="/cart/add" method="POST" class="add-cart-form" id="addCartForm">
                    <input type="hidden" name="productId" value="<%= product.id %>">
                    <input type="hidden" name="variantId" id="variantIdInput" value="0">
                    <label>পরিমাণ:
                        <input type="number" name="quantity" id="quantityInput" value="1" min="1" max="<%= variantOptions.length > 0 ? 1 : product.stock %>">
                    </label>
                    <button type="submit" class="btn-primary" id="addCartBtn" <%= variantOptions.length > 0 ? 'disabled' : '' %>>কার্টে যোগ করুন</button>
                </form>
                <%
                    const waText = encodeURIComponent(
                        `আমি এই প্রোডাক্টটি অর্ডার করতে চাই:\n${product.name}\nদাম: ৳${basePrice.toLocaleString('en-BD')}\nলিংক: ${typeof ogUrl !== 'undefined' && ogUrl ? ogUrl : ('/product/' + product.id)}`
                    );
                %>
                <a href="https://wa.me/8801735698806?text=<%= waText %>" target="_blank" rel="noopener" class="btn-whatsapp-order">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.02 2C6.5 2 2 6.48 2 12c0 1.77.46 3.45 1.32 4.94L2 22l5.2-1.29A9.96 9.96 0 0 0 12.02 22C17.53 22 22 17.52 22 12S17.53 2 12.02 2Zm0 18.13c-1.62 0-3.16-.44-4.5-1.26l-.32-.19-3.09.77.78-3.04-.2-.32A8.1 8.1 0 1 1 12.02 20.1Z"/></svg>
                    WhatsApp-এ অর্ডার করুন
                </a>
            </div>
            <% if (variantOptions.length > 0) { %>
            <script>
            (function () {
                var select = document.getElementById('variantSelect');
                var variantIdInput = document.getElementById('variantIdInput');
                var quantityInput = document.getElementById('quantityInput');
                var addBtn = document.getElementById('addCartBtn');
                var stockInfo = document.getElementById('stockInfo');
                var priceCurrent = document.getElementById('priceCurrent');

                select.addEventListener('change', function () {
                    var opt = select.options[select.selectedIndex];
                    if (!select.value) {
                        variantIdInput.value = '0';
                        addBtn.disabled = true;
                        stockInfo.textContent = 'ভ্যারিয়েন্ট বাছাই করলে স্টক দেখাবে';
                        return;
                    }
                    var price = parseFloat(opt.dataset.price);
                    var stock = parseInt(opt.dataset.stock, 10);
                    variantIdInput.value = select.value;
                    quantityInput.max = stock;
                    quantityInput.value = Math.min(parseInt(quantityInput.value, 10) || 1, Math.max(stock, 1));
                    priceCurrent.textContent = '৳' + price.toLocaleString('en-BD');
                    stockInfo.textContent = stock > 0 ? ('স্টকে আছে: ' + stock + ' টি') : 'এই ভ্যারিয়েন্টে স্টক নেই';
                    addBtn.disabled = stock <= 0;
                });
            })();
            </script>
            <% } %>
        <% } else { %>
            <p class="stock-badge out">এই মুহূর্তে স্টক নেই</p>
            <div class="notify-me-box" id="notify-me">
                <% if (notifyMeSuccess) { %>
                    <p class="notify-me-success">✅ ধন্যবাদ! স্টক এলে আমরা আপনাকে জানানোর চেষ্টা করব।</p>
                <% } else { %>
                    <form action="/product/<%= product.id %>/notify-me" method="POST" class="notify-me-form">
                        <label>স্টক এলে জানান — ফোন নম্বর দিন
                            <input type="tel" name="phone" placeholder="01XXXXXXXXX" required>
                        </label>
                        <button type="submit" class="btn-primary">নোটিফাই করুন</button>
                    </form>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<% if (product.description) { %>
<section class="description-section">
    <h2 class="section-title">বিবরণ</h2>
    <p class="description"><%= product.description %></p>
</section>
<% } %>

<% if (product.specs && product.specs.length > 0) { %>
<section class="spec-section">
    <h2 class="section-title">স্পেসিফিকেশন</h2>
    <table class="spec-table">
        <tbody>
            <% product.specs.forEach(s => { %>
                <tr><th><%= s.label %></th><td><%= s.value %></td></tr>
            <% }) %>
        </tbody>
    </table>
</section>
<% } %>

<section class="reviews-section" id="reviews">
    <h2 class="section-title">কাস্টমার রিভিউ <% if (reviewCount > 0) { %>(<%= reviewCount %>)<% } %></h2>

    <% if (reviews.length === 0) { %>
        <p class="empty-msg">এখনও কোনো রিভিউ নেই। প্রথম রিভিউ আপনিই দিন!</p>
    <% } else { %>
        <div class="review-list">
            <% reviews.forEach(r => { %>
                <div class="review-item">
                    <div class="review-item-head">
                        <span class="review-author"><%= r.customer_name %></span>
                        <% if (r.verified_purchase) { %><span class="badge-verified" title="যাচাইকৃত ক্রেতা — এই ফোন নম্বর দিয়ে অর্ডার করা হয়েছে">✅ যাচাইকৃত ক্রেতা</span><% } %>
                        <span class="star-rating small">
                            <% for (let i = 1; i <= 5; i++) { %><span class="star <%= i <= r.rating ? 'filled' : '' %>">★</span><% } %>
                        </span>
                    </div>
                    <% if (r.comment) { %><p class="review-comment"><%= r.comment %></p><% } %>
                    <p class="review-date"><%= new Date(r.created_at).toLocaleDateString('en-GB') %></p>
                </div>
            <% }) %>
        </div>
    <% } %>

    <form action="/product/<%= product.id %>/review" method="POST" class="review-form">
        <h3>আপনার রিভিউ দিন</h3>
        <% if (reviewError) { %><p class="error-msg"><%= reviewError %></p><% } %>
        <% if (typeof rateLimited !== 'undefined' && rateLimited) { %><p class="error-msg">অনেকবার রিভিউ দেওয়ার চেষ্টা করা হয়েছে। কিছুক্ষণ পর আবার চেষ্টা করুন।</p><% } %>
        <div class="review-form-row">
            <label>আপনার নাম *
                <input type="text" name="customerName" required>
            </label>
            <label>রেটিং *
                <select name="rating" required>
                    <option value="">বেছে নিন</option>
                    <option value="5">★★★★★ চমৎকার</option>
                    <option value="4">★★★★☆ ভালো</option>
                    <option value="3">★★★☆☆ মোটামুটি</option>
                    <option value="2">★★☆☆☆ খারাপ</option>
                    <option value="1">★☆☆☆☆ খুবই খারাপ</option>
                </select>
            </label>
        </div>
        <label>ফোন নম্বর <span class="field-hint">(ঐচ্ছিক — আপনি যদি এই নম্বর দিয়ে অর্ডার করে থাকেন, রিভিউতে "যাচাইকৃত ক্রেতা" ব্যাজ দেখাবে। নম্বরটি প্রকাশ্যে দেখানো হবে না।)</span>
            <input type="tel" name="phone" placeholder="01XXXXXXXXX">
        </label>
        <label>মন্তব্য
            <textarea name="comment" rows="3" placeholder="প্রোডাক্ট নিয়ে আপনার অভিজ্ঞতা লিখুন..."></textarea>
        </label>
        <button type="submit" class="btn-primary">রিভিউ জমা দিন</button>
    </form>
</section>

<%- include('partials/footer') %>
