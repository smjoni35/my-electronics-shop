<%- include('partials/header', { title: product.name + ' - ' + storeName }) %>

<div class="product-detail">
    <div class="product-detail-img">
        <% const allPhotos = [product.image_url, ...galleryImages.map(g => g.image_url)].filter(Boolean); %>
        <% if (allPhotos.length > 0) { %>
            <img id="main-product-photo" src="<%= allPhotos[0] %>" alt="<%= product.name %>" loading="lazy">
            <% if (allPhotos.length > 1) { %>
            <div class="gallery-thumbs">
                <% allPhotos.forEach((url, i) => { %>
                    <img src="<%= url %>" class="gallery-thumb <%= i === 0 ? 'active' : '' %>" onclick="document.getElementById('main-product-photo').src = this.src; document.querySelectorAll('.gallery-thumb').forEach(t => t.classList.remove('active')); this.classList.add('active');">
                <% }) %>
            </div>
            <% } %>
        <% } else { %>
            <div class="no-img large">ছবি নেই</div>
        <% } %>
    </div>
    <div class="product-detail-info">
        <h1><%= product.name %></h1>
        <p class="price large">৳<%= parseFloat(product.price).toLocaleString('en-BD') %></p>
        <% if (product.category) { %><p class="category-tag"><%= product.category %></p><% } %>
        <p class="description"><%= product.description %></p>

        <% if (product.stock > 0) { %>
            <p class="stock-info stock-dot">স্টকে আছে: <%= product.stock %> টি</p>
            <form action="/cart/add" method="POST" class="add-cart-form">
                <input type="hidden" name="productId" value="<%= product.id %>">
                <label>পরিমাণ:
                    <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>">
                </label>
                <button type="submit" class="btn-primary">কার্টে যোগ করুন</button>
            </form>
        <% } else { %>
            <p class="stock-badge out">এই মুহূর্তে স্টক নেই</p>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
