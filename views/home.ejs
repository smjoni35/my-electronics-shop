<%- include('partials/header') %>
<section class="hero">
    <p class="hero-eyebrow">// বিশ্বস্ত অনলাইন ইলেকট্রনিক্স শপ</p>
    <h1 class="hero-title"><%= storeName %></h1>
    <p class="hero-sub">অরিজিনাল পণ্য, সঠিক দাম এবং দ্রুত ডেলিভারি — আপনার প্রয়োজনীয় ইলেকট্রনিক্স এখন এক জায়গায়।</p>
</section>

<div class="category-bar">
    <a href="/" class="<%= activeCategory === '' ? 'active' : '' %>">All products</a>
    <% categories.forEach(c => { %>
        <a href="/?category=<%= encodeURIComponent(c.category) %>" class="<%= activeCategory === c.category ? 'active' : '' %>"><%= c.category %></a>
    <% }) %>
</div>

<h1 class="page-title">Products</h1>

<% if (products.length === 0) { %>
    <p class="empty-msg">No products found.</p>
<% } else { %>
<div class="product-grid">
    <% products.forEach(p => { %>
        <a href="/product/<%= p.id %>" class="product-card">
            <div class="product-img">
                <% if (p.image_url) { %>
                    <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy">
                <% } else { %>
                    <div class="no-img">No picture.</div>
                <% } %>
            </div>
            <div class="product-info">
                <h3><%= p.name %></h3>
                <p class="price">৳<%= parseFloat(p.price).toLocaleString('en-BD') %></p>
                <% if (p.stock <= 0) { %>
                    <span class="stock-badge out">Not in stock</span>
                <% } %>
            </div>
        </a>
    <% }) %>
</div>
<% } %>

<%- include('partials/footer') %>
