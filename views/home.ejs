<%- include('partials/header') %>

<% if (typeof bestSellers !== 'undefined' && bestSellers.length > 0) { %>
<div class="hero-slider" id="heroSlider">
    <div class="hero-track" id="heroTrack">
        <% bestSellers.forEach(p => { %>
            <a href="/product/<%= p.id %>" class="hero-slide">
                <% if (p.image_url) { %>
                    <img src="<%= p.image_url %>" alt="<%= p.name %>">
                <% } %>
                <div class="hero-slide-overlay">
                    <span class="hero-tag">🏆 Best Seller</span>
                    <h2 class="hero-slide-title"><%= p.name %></h2>
                    <p class="hero-slide-price">
                        <% if (p.discount_percent > 0) { %>
                            ৳<%= parseFloat(p.effective_price).toLocaleString('en-BD') %>
                            <span class="hero-slide-price-original">৳<%= parseFloat(p.price).toLocaleString('en-BD') %></span>
                        <% } else { %>
                            ৳<%= parseFloat(p.price).toLocaleString('en-BD') %>
                        <% } %>
                    </p>
                </div>
            </a>
        <% }) %>
    </div>
    <% if (bestSellers.length > 1) { %>
        <div class="hero-dots" id="heroDots">
            <% bestSellers.forEach((p, i) => { %>
                <button type="button" class="hero-dot <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>" aria-label="Slide <%= i + 1 %>"></button>
            <% }) %>
        </div>
    <% } %>
</div>
<script>
(function () {
    const track = document.getElementById('heroTrack');
    const dots = document.querySelectorAll('#heroDots .hero-dot');
    if (!track || dots.length === 0) return;
    let index = 0;
    let autoplay;

    function goTo(i) {
        index = (i + dots.length) % dots.length;
        track.scrollTo({ left: track.clientWidth * index, behavior: 'smooth' });
        dots.forEach((d, di) => d.classList.toggle('active', di === index));
    }
    dots.forEach(d => d.addEventListener('click', () => { goTo(parseInt(d.dataset.index, 10)); resetAutoplay(); }));

    let scrollTimeout;
    track.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            const i = Math.round(track.scrollLeft / track.clientWidth);
            index = i;
            dots.forEach((d, di) => d.classList.toggle('active', di === index));
        }, 100);
    });

    function resetAutoplay() {
        clearInterval(autoplay);
        autoplay = setInterval(() => goTo(index + 1), 4000);
    }
    resetAutoplay();
})();
</script>
<% } %>

<div class="category-bar-wrap">
    <div class="category-bar">
        <a href="/" class="<%= activeCategory === '' ? 'active' : '' %>">All products</a>
        <% categories.forEach(c => { %>
            <a href="/?category=<%= encodeURIComponent(c.category) %>" class="<%= activeCategory === c.category ? 'active' : '' %>"><%= c.category %></a>
        <% }) %>
    </div>
</div>

<div class="toolbar-row">
    <h1 class="page-title">Products</h1>
    <form method="GET" class="sort-form">
        <% if (activeCategory) { %><input type="hidden" name="category" value="<%= activeCategory %>"><% } %>
        <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
        <label class="sort-label">Sort:
            <select name="sort" onchange="this.form.submit()">
                <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>নতুন প্রোডাক্ট আগে</option>
                <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>দাম: কম → বেশি</option>
                <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>দাম: বেশি → কম</option>
            </select>
        </label>
    </form>
</div>

<% if (products.length === 0) { %>
    <p class="empty-msg">No products found.</p>
<% } else { %>
<div class="product-grid">
    <% products.forEach(p => {
        const isNew = (Date.now() - new Date(p.created_at).getTime()) < NEW_PRODUCT_DAYS * 24 * 60 * 60 * 1000;
        const isLowStock = p.stock > 0 && p.stock <= LOW_STOCK_THRESHOLD;
        const rating = parseFloat(p.avg_rating) || 0;
    %>
        <div class="product-card">
            <a href="/product/<%= p.id %>" class="product-card-link">
                <div class="product-img">
                    <div class="badge-stack">
                        <% if (bestSellerIds.includes(p.id)) { %>
                            <span class="badge-bestseller">🏆 Best Seller</span>
                        <% } %>
                        <% if (isNew) { %>
                            <span class="badge-new">✨ New</span>
                        <% } %>
                        <% if (p.discount_percent > 0) { %>
                            <span class="badge-discount"><%= p.discount_percent %>% OFF</span>
                        <% } %>
                    </div>
                    <% if (p.image_url) { %>
                        <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy">
                    <% } else { %>
                        <div class="no-img">No picture.</div>
                    <% } %>
                </div>
                <div class="product-info">
                    <h3><%= p.name %></h3>
                    <% if (p.review_count > 0) { %>
                        <div class="star-rating" title="<%= rating.toFixed(1) %> / 5">
                            <% for (let i = 1; i <= 5; i++) { %><span class="star <%= i <= Math.round(rating) ? 'filled' : '' %>">★</span><% } %>
                            <span class="review-count">(<%= p.review_count %>)</span>
                        </div>
                    <% } %>
                    <% if (p.discount_percent > 0) { %>
                        <p class="price-row">
                            <span class="price">৳<%= parseFloat(p.effective_price).toLocaleString('en-BD') %></span>
                            <span class="price-original">৳<%= parseFloat(p.price).toLocaleString('en-BD') %></span>
                        </p>
                    <% } else { %>
                        <p class="price">৳<%= parseFloat(p.price).toLocaleString('en-BD') %></p>
                    <% } %>
                    <% if (p.stock <= 0) { %>
                        <span class="stock-badge out">Not in stock</span>
                    <% } else if (isLowStock) { %>
                        <span class="badge-lowstock">মাত্র <%= p.stock %>টা বাকি</span>
                    <% } %>
                </div>
            </a>
        </div>
    <% }) %>
</div>
<% } %>

<%- include('partials/footer') %>
