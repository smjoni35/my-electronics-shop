<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : storeName %></title>
    <% const _ogTitle = typeof ogTitle !== 'undefined' ? ogTitle : storeName; %>
    <% const _ogDesc = typeof ogDescription !== 'undefined' ? ogDescription : ''; %>
    <% const _ogImage = typeof ogImage !== 'undefined' ? ogImage : ''; %>
    <% const _ogUrl = typeof ogUrl !== 'undefined' ? ogUrl : (typeof baseUrl !== 'undefined' ? baseUrl + (typeof reqPath !== 'undefined' ? reqPath : '') : ''); %>
    <% if (_ogDesc) { %><meta name="description" content="<%= _ogDesc %>"><% } %>
    <meta property="og:site_name" content="<%= storeName %>">
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
    <meta property="og:title" content="<%= _ogTitle %>">
    <% if (_ogDesc) { %><meta property="og:description" content="<%= _ogDesc %>"><% } %>
    <% if (_ogImage) { %><meta property="og:image" content="<%= _ogImage %>"><% } %>
    <% if (_ogUrl) { %><meta property="og:url" content="<%= _ogUrl %>"><% } %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= _ogTitle %>">
    <% if (_ogDesc) { %><meta name="twitter:description" content="<%= _ogDesc %>"><% } %>
    <% if (_ogImage) { %><meta name="twitter:image" content="<%= _ogImage %>"><% } %>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a href="/" class="logo"><span class="logo-chip"><img src="/img/logo.png" alt="<%= storeName %>" class="logo-img"></span><span class="logo-text"><%= storeName %></span></a>
            <form action="/" method="GET" class="search-form">
                <span class="search-prompt">&#10095;</span>
                <input type="text" name="q" placeholder="Find the product..." value="<%= typeof q !== 'undefined' ? q : '' %>" enterkeyhint="search">
                <button type="submit" aria-label="Search"><span class="search-btn-icon">🔍</span><span class="search-btn-text">Search</span></button>
            </form>
            <div class="header-actions">
                <a href="/track-order" class="track-order-link">📦 <span class="cart-text">আমার অর্ডার</span></a>
                <% if (typeof currentCustomerId !== 'undefined' && currentCustomerId) { %>
                    <a href="/account/dashboard" class="track-order-link">👤 <span class="cart-text">আমার অ্যাকাউন্ট</span></a>
                <% } else { %>
                    <a href="/account/login" class="track-order-link">👤 <span class="cart-text">লগইন</span></a>
                <% } %>
                <a href="/cart" class="cart-link">🛒 <span class="cart-text">Cart</span> <span class="cart-count"><%= cartCount %></span></a>
            </div>
        </div>
    </header>
    <main class="container">
