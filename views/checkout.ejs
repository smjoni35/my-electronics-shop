<%- include('partials/header', { title: 'Checkout - ' + storeName }) %>

<h1 class="page-title">Checkout</h1>
<p class="info-note">Payment Method: <strong>Cash on delivery (COD)</strong> — Pay when you receive the product.</p>

<% if (error) { %>
    <p class="error-msg"><%= error %></p>
<% } %>

<form action="/checkout" method="POST" class="checkout-form">
    <label>Full name *
        <input type="text" name="customerName" required>
    </label>
    <label>Mobile number *
        <input type="tel" name="phone" required placeholder="01XXXXXXXXX">
    </label>
    <label>City
        <input type="text" name="city" placeholder="Dhaka, Chittagong...">
    </label>
    <label>Full address *
        <textarea name="address" required rows="3"></textarea>
    </label>
    <button type="submit" class="btn-primary">Confirm order.</button>
</form>

<%- include('partials/footer') %>
