<%- include('partials/header', { title: 'Cart - ' + storeName }) %>

<h1 class="page-title">Your cart</h1>

<% if (items.length === 0) { %>
    <p class="empty-msg">Your cart is empty.<a href="/">Start shopping</a></p>
<% } else { %>
    <div class="cart-list">
        <% items.forEach(item => { %>
            <div class="cart-item">
                <div class="cart-item-img">
                    <% if (item.image_url) { %>
                        <img src="<%= item.image_url %>" alt="<%= item.name %>" loading="lazy">
                    <% } else { %>
                        <div class="no-img small">No picture.</div>
                    <% } %>
                </div>
                <div class="cart-item-info">
                    <h3><%= item.name %></h3>
                    <p>৳<%= parseFloat(item.price).toLocaleString('en-BD') %> x <%= item.quantity %></p>
                </div>
                <div class="cart-item-actions">
                    <form action="/cart/update" method="POST">
                        <input type="hidden" name="productId" value="<%= item.id %>">
                        <input type="number" name="quantity" value="<%= item.quantity %>" min="0" max="<%= item.stock %>">
                        <button type="submit">Update</button>
                    </form>
                    <form action="/cart/remove" method="POST">
                        <input type="hidden" name="productId" value="<%= item.id %>">
                        <button type="submit" class="btn-remove">Delete</button>
                    </form>
                </div>
                <div class="cart-item-subtotal">৳<%= item.subtotal.toLocaleString('en-BD') %></div>
            </div>
        <% }) %>
    </div>
    <div class="cart-summary">
        <p class="cart-total">Total: ৳<%= total.toLocaleString('en-BD') %></p>
        <a href="/checkout" class="btn-primary">Checkout</a>
    </div>
<% } %>

<%- include('partials/footer') %>
