<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customers — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('nav') %>
    <div class="container">
        <%
            // Builds a wa.me deep-link with a ready-made "new product" message.
            // Bangladeshi numbers are stored as 01XXXXXXXXX; WhatsApp needs 8801XXXXXXXXX.
            function waLink(phone) {
                var digits = (phone || '').replace(/\D/g, '');
                if (digits.startsWith('0')) digits = '880' + digits.slice(1);
                else if (!digits.startsWith('880')) digits = '880' + digits;
                var msg = 'আসসালামু আলাইকুম! আমরা ' + storeName + ' থেকে বলছি। আমাদের নতুন প্রোডাক্ট এসেছে — দেখে নিতে পারেন: ' + baseUrl;
                return 'https://wa.me/' + digits + '?text=' + encodeURIComponent(msg);
            }
        %>
        <div class="admin-header-row">
            <h1>Customers</h1>
        </div>
        <p class="dash-stat-caption" style="margin: -10px 0 16px;">রেজিস্টার্ড এবং গেস্ট চেকআউট — দুই ধরনের কাস্টমারই এখানে দেখানো হচ্ছে (ফোন নম্বর অনুযায়ী)।</p>

        <div class="table-scroll">
        <table class="admin-table">
            <thead>
                <tr><th>Name</th><th>Phone</th><th>Type</th><th>Orders</th><th>Total Spent</th><th>Last Order</th><th>Contact</th></tr>
            </thead>
            <tbody>
                <% if (customers.length === 0) { %>
                <tr><td colspan="7" class="dash-empty">এখনো কোনো কাস্টমার নেই।</td></tr>
                <% } %>
                <% customers.forEach(c => { %>
                <tr>
                    <td><%= c.name %><% if (c.email) { %><div class="mini-sub"><%= c.email %></div><% } %></td>
                    <td><%= c.phone %></td>
                    <td>
                        <% if (c.is_registered) { %>
                        <span class="status-badge confirmed">Registered</span>
                        <% } else { %>
                        <span class="status-badge pending">Guest</span>
                        <% } %>
                    </td>
                    <td><%= c.order_count %></td>
                    <td>৳<%= parseFloat(c.total_spent).toLocaleString('en-BD') %></td>
                    <td><%= c.last_order_at ? new Date(c.last_order_at).toLocaleDateString('en-BD') : '-' %></td>
                    <td>
                        <div class="order-actions-inline">
                            <a href="tel:<%= c.phone %>" class="order-icon-btn" title="Call">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            </a>
                            <a href="<%= waLink(c.phone) %>" target="_blank" rel="noopener" class="order-icon-btn" title="WhatsApp">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                            </a>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        </div>
    </div>
    <%- include('nav-end') %>
</body>
</html>
