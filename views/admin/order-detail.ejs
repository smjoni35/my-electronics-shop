<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order #<%= order.id %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('nav') %>
    <div class="container">
        <h1>Order #<%= order.id %></h1>
        <% if (typeof updatedSuccess !== 'undefined' && updatedSuccess) { %>
            <p class="info-note">✅ অর্ডার স্ট্যাটাস সফলভাবে আপডেট হয়েছে।</p>
        <% } %>
        <div class="order-detail-box">
            <p><strong>Customer:</strong> <%= order.customer_name %></p>
            <p><strong>Phone:</strong> <%= order.phone %></p>
            <p><strong>Address:</strong> <%= order.address %>, <%= order.city %></p>
            <p><strong>Total:</strong> ৳<%= parseFloat(order.total).toLocaleString('en-BD') %></p>
            <p><strong>Payment:</strong> Cash on Delivery</p>

            <div class="order-actions-row">
                <form action="/admin/orders/<%= order.id %>/status" method="POST" class="status-form">
                    <label>:
                        <select name="status">
                            <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                            <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Shipped</option>
                            <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                            <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                        </select>
                    </label>
                    <button type="submit" class="btn-primary">Update</button>
                </form>

                <form action="/admin/orders/<%= order.id %>/delete" method="POST" class="status-form" onsubmit="return confirm('এই অর্ডারটি স্থায়ীভাবে মুছে ফেলা হবে, এটা আর ফেরত আনা যাবে না। আপনি কি নিশ্চিত?')">
                    <button type="submit" class="btn-remove">🗑️ Delete Order</button>
                </form>
            </div>
        </div>

        <h2>প্রোডাক্টসমূহ</h2>
        <div class="table-scroll">
        <table class="admin-table">
            <thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th></tr></thead>
            <tbody>
                <% items.forEach(item => { %>
                <tr>
                    <td><%= item.product_name %></td>
                    <td>৳<%= parseFloat(item.price).toLocaleString('en-BD') %></td>
                    <td><%= item.quantity %></td>
                    <td>৳<%= (item.price * item.quantity).toLocaleString('en-BD') %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        </div>
        <a href="/admin/orders">← Return to order list</a>
    </div>
</body>
</html>
