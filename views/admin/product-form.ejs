<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product ? 'Product Edit' : 'New product' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('nav') %>
    <div class="container admin-form-page">
        <h1><%= product ? 'Edit product' : 'Add new product' %></h1>
        <% if (error) { %><p class="error-msg"><%= error %></p><% } %>

        <form action="<%= product ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>" method="POST" enctype="multipart/form-data" class="admin-form">
            <label>Product name *
                <input type="text" name="name" value="<%= product ? product.name : '' %>" required>
            </label>
            <label>Description
                <textarea name="description" rows="4"><%= product ? product.description : '' %></textarea>
            </label>
            <label>Price (৳) *
                <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required>
            </label>
            <label>Stock quantity *
                <input type="number" name="stock" value="<%= product ? product.stock : 0 %>" required>
            </label>
            <label>Categories
                <input type="text" name="category" value="<%= product ? product.category : '' %>" placeholder="যেমন: মোবাইল এক্সেসরিজ">
            </label>
            <label>Discount (%) <span class="field-hint">০ দিলে কোনো ডিসকাউন্ট ব্যাজ দেখাবে না</span>
                <input type="number" name="discountPercent" min="0" max="90" value="<%= product ? product.discount_percent : 0 %>">
            </label>
            <label>Product Image <% if (product) { %>(Previous photos will remain.)<% } %>
                <input type="file" name="image" accept="image/*">
            </label>
            <% if (product && product.image_url) { %>
                <img src="<%= product.image_url %>" class="thumb-preview">
            <% } %>
            <button type="submit" class="btn-primary">Save</button>
        </form>
    </div>
</body>
</html>
