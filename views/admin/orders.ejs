<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>অর্ডারসমূহ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('nav') %>
    <div class="container">
        <h1>অর্ডারসমূহ</h1>
        <table class="admin-table">
            <thead>
                <tr><th>#</th><th>কাস্টমার</th><th>ফোন</th><th>মোট</th><th>স্ট্যাটাস</th><th>তারিখ</th><th></th></tr>
            </thead>
            <tbody>
                <% orders.forEach(o => { %>
                <tr>
                    <td>#<%= o.id %></td>
                    <td><%= o.customer_name %></td>
                    <td><%= o.phone %></td>
                    <td>৳<%= parseFloat(o.total).toLocaleString('en-BD') %></td>
                    <td><span class="status-badge <%= o.status %>"><%= o.status %></span></td>
                    <td><%= new Date(o.created_at).toLocaleDateString('en-BD') %></td>
                    <td><a href="/admin/orders/<%= o.id %>">বিস্তারিত</a></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>
