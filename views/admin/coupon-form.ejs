<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= coupon && coupon.id ? 'Edit Coupon' : 'New Coupon' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('nav') %>
    <div class="container admin-form-page">
        <h1><%= coupon && coupon.id ? 'Edit Coupon' : 'Add new coupon' %></h1>
        <% if (error) { %><p class="error-msg"><%= error %></p><% } %>

        <% const c = coupon || {}; %>
        <form action="<%= c.id ? '/admin/coupons/' + c.id + '/edit' : '/admin/coupons/new' %>" method="POST" class="admin-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>Coupon code * <span class="field-hint">কাস্টমার এটাই চেকআউটে টাইপ করবে, যেমন EID50</span>
                <input type="text" name="code" value="<%= c.code || '' %>" style="text-transform: uppercase;" required>
            </label>
            <label>Discount type *
                <select name="type">
                    <option value="percent" <%= (!c.type || c.type === 'percent') ? 'selected' : '' %>>Percentage (%)</option>
                    <option value="fixed" <%= c.type === 'fixed' ? 'selected' : '' %>>Fixed amount (৳)</option>
                </select>
            </label>
            <label>Value * <span class="field-hint">টাইপ Percentage হলে ১০ মানে ১০%, Fixed হলে ১০ মানে ৳১০</span>
                <input type="number" step="0.01" min="0" name="value" value="<%= c.value || '' %>" required>
            </label>
            <label>Maximum discount (৳) <span class="field-hint">শুধু Percentage কুপনের জন্য — ঐচ্ছিক ক্যাপ, খালি রাখলে সীমা নেই</span>
                <input type="number" step="0.01" min="0" name="maxDiscountAmount" value="<%= c.max_discount_amount || '' %>">
            </label>
            <label>Minimum order amount (৳) <span class="field-hint">০ দিলে কোনো ন্যূনতম শর্ত থাকবে না</span>
                <input type="number" step="0.01" min="0" name="minOrderAmount" value="<%= c.min_order_amount || 0 %>">
            </label>
            <label>Usage limit <span class="field-hint">সর্বমোট কতবার ব্যবহার করা যাবে — খালি রাখলে সীমাহীন</span>
                <input type="number" min="1" name="usageLimit" value="<%= c.usage_limit || '' %>">
            </label>
            <label>Expiry date <span class="field-hint">খালি রাখলে মেয়াদ শেষ হবে না</span>
                <input type="date" name="expiresAt" value="<%= c.expires_at ? new Date(c.expires_at).toISOString().slice(0,10) : '' %>">
            </label>
            <label class="checkbox-row">
                <input type="checkbox" name="active" <%= (c.active === undefined || c.active) ? 'checked' : '' %>>
                সক্রিয় (Active)
            </label>
            <button type="submit" class="btn-primary">Save</button>
        </form>
        <a href="/admin/coupons" class="back-link">← Return to coupon list</a>
    </div>
    <%- include('nav-end') %>
</body>
</html>
