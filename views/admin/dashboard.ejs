<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('nav') %>
    <div class="container">
        <div class="stats-row">
            <div class="stat-box">Total Order<strong><%= stats.total_orders %></strong></div>
            <div class="stat-box">Total Sell<strong>৳<%= parseFloat(stats.total_revenue).toLocaleString('en-BD') %></strong></div>
            <div class="stat-box">Total Product<strong><%= products.length %></strong></div>
        </div>

        <% if (bestSellers.length > 0) { %>
        <div class="admin-header-row">
            <h1>🏆 Best Sellers</h1>
        </div>
        <table class="admin-table best-sellers-table">
            <thead>
                <tr><th>Photo</th><th>Product</th><th>Total Sold</th><th>Total Revenue</th></tr>
            </thead>
            <tbody>
                <% bestSellers.forEach((b, i) => { %>
                <tr>
                    <td><% if (b.image_url) { %><img src="<%= b.image_url %>" class="thumb"><% } %></td>
                    <td><%= i === 0 ? '🥇 ' : (i === 1 ? '🥈 ' : (i === 2 ? '🥉 ' : '')) %><%= b.product_name %></td>
                    <td><%= b.total_sold %> pcs</td>
                    <td>৳<%= parseFloat(b.total_revenue).toLocaleString('en-BD') %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        <% } %>

        <div class="admin-header-row">
            <h1>Products</h1>
            <% if (currentRole !== 'moderator') { %>
            <a href="/admin/products/new" class="btn-primary">+ Add Product</a>
            <% } %>
        </div>

        <table class="admin-table">
            <thead>
                <tr><th>Photo</th><th>Name</th><th>Price</th><th>Stock</th><th>Category</th><th>Action</th></tr>
            </thead>
            <tbody>
                <% products.forEach(p => { %>
                <tr>
                    <td><% if (p.image_url) { %><img src="<%= p.image_url %>" class="thumb"><% } %></td>
                    <td><%= p.name %></td>
                    <td>৳<%= parseFloat(p.price).toLocaleString('en-BD') %></td>
                    <td><%= p.stock %></td>
                    <td><%= p.category || '-' %></td>
                    <td class="actions">
                        <div class="actions-inner">
                            <a href="/admin/products/<%= p.id %>/edit">Edit</a>
                            <% if (currentRole !== 'moderator') { %>
                            <form action="/admin/products/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Confirm?')">
                                <button type="submit" class="btn-remove">Delete</button>
                            </form>
                            <% } %>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>
